{
  "name": "chorale-functions",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "volta": {
    "extends": "../package.json"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec test/lib.test.js",
    "test:e2e": "cd .. && firebase emulators:exec --only functions,firestore,storage --project demo-chorale \"npm --prefix functions run test:e2e:run\"",
    "test:e2e:run": "node --test --test-reporter=spec test/e2e.test.js"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  }
}
