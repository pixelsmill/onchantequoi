rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Plusieurs chorales : choirs/{c}/songs et choirs/{c}/files (c = « 1 », « 2 »…).
    // Un téléphone est membre de la chorale c s'il a rejoint avec une clé qui existe encore
    // et qui ouvre cette chorale (keys/{clé}.choir, « 1 » si absent).
    // Supprimer une clé dans /keys coupe donc l'accès à tous ceux qui l'ont utilisée.
    function memberOf(c) {
      return request.auth != null && hasLiveKey(request.auth.uid, c);
    }
    function hasLiveKey(uid, c) {
      let m = get(/databases/$(database)/documents/members/$(uid)).data;
      // Ancienne fiche { key, at } : elle vaut pour la chorale 1
      let k = m.get('keys', {}).get(c, c == '1' ? m.get('key', '') : '');
      return k is string && k != '' && keyChoir(k) == c;
    }
    function keyChoir(k) {
      return get(/databases/$(database)/documents/keys/$(k)).data.get('choir', '1');
    }
    function isChoirId(c) {
      return c is string && c.matches('^[0-9a-z-]{1,20}$');
    }
    function isKey(k) {
      // Même format de clé que la fonction depot : 10 à 128 caractères parmi A-Z a-z 0-9 _ -
      return k is string && k.matches('^[A-Za-z0-9_-]{10,128}$');
    }

    // Les clés : jamais lisibles ni modifiables depuis l'app (gérées dans la console).
    match /keys/{key} {
      allow read, write: if false;
    }

    // Rejoindre : on n'écrit que sa propre fiche, avec une clé valide pour la chorale.
    //   { keys: { <chorale>: <clé> }, last: <chorale ajoutée>, at: serverTimestamp() }
    //   (ancienne version de l'app : { key, at }, pour la chorale 1)
    match /members/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && validMember(request.resource.data, resource == null ? {} : resource.data);
      allow list, delete: if false;
    }
    function validMember(d, before) {
      return d.keys().hasOnly(['key', 'keys', 'last', 'at'])
        && d.at == request.time
        && (legacyJoin(d, before) || choirJoin(d, before));
    }
    // Ancienne version de l'app : seule la clé (chorale 1) change
    function legacyJoin(d, before) {
      return isKey(d.get('key', null)) && keyChoir(d.key) == '1'
        && d.get('keys', null) == before.get('keys', null)
        && d.get('last', null) == before.get('last', null);
    }
    // Une seule chorale ajoutée ou changée à la fois (celle nommée dans last)
    function choirJoin(d, before) {
      return isChoirId(d.get('last', null))
        && d.get('keys', null) is map
        && d.keys.diff(before.get('keys', {})).affectedKeys().hasOnly([d.last])
        && d.last in d.keys
        && isKey(d.keys[d.last])
        && keyChoir(d.keys[d.last]) == d.last
        && d.get('key', null) == before.get('key', null);
    }

    // Nom de la chorale et du chef : { name, teacher } (créés dans la console ou par le script)
    match /choirs/{c} {
      allow get: if memberOf(c);
      allow list, write: if false;

      // Répertoire des morceaux : { title, voices: { S|A|H|T: { hash, at } }, lyrics?, createdAt, updatedAt }
      match /songs/{songId} {
        allow read, delete: if memberOf(c);
        allow create, update: if memberOf(c) && validSong(request.resource.data);
      }

      // Fichiers audio reçus (id = empreinte SHA-256 du fichier, évite les doublons)
      match /files/{hash} {
        allow read, delete: if memberOf(c);
        allow create: if memberOf(c) && isSha256(hash) && validNewFile(request.resource.data);
        allow update: if memberOf(c)
          && validFileChange(c, hash, request.resource.data, resource.data);
      }
    }

    // Transition : anciens emplacements de la chorale 1, pour les téléphones qui n'ont pas
    // encore la nouvelle version. À retirer après la migration (voir LISEZMOI).
    match /songs/{songId} {
      allow read, delete: if memberOf('1');
      allow create, update: if memberOf('1') && validSong(request.resource.data);
    }
    match /files/{hash} {
      allow read, delete: if memberOf('1');
      allow create: if memberOf('1') && isSha256(hash) && validNewFile(request.resource.data);
      allow update: if memberOf('1')
        && validFileChange('', hash, request.resource.data, resource.data);
    }

    function isSha256(s) {
      return s is string && s.matches('^[0-9a-f]{64}$');
    }

    function validSong(d) {
      return d.keys().hasOnly(['title', 'voices', 'lyrics', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.trim().size() > 0 && d.title.size() <= 120
        && (!('voices' in d) || validVoices(d.voices))
        && (!('lyrics' in d) || (d.lyrics is string && d.lyrics.size() <= 20000))
        && (!('createdAt' in d) || d.createdAt is number)
        && (!('updatedAt' in d) || d.updatedAt is number);
    }
    function validVoices(v) {
      return v is map && v.keys().hasOnly(['S', 'A', 'H', 'T'])
        && (!('S' in v) || validVoice(v.S)) && (!('A' in v) || validVoice(v.A))
        && (!('H' in v) || validVoice(v.H)) && (!('T' in v) || validVoice(v.T));
    }
    function validVoice(x) {
      return x is map && x.keys().hasOnly(['hash', 'at']) && isSha256(x.hash) && x.at is number;
    }

    // name, size, type et duration (secondes) sont facultatifs : « Mal classé ? » recrée un
    // document minimal s'il a disparu
    function validNewFile(d) {
      return d.keys().hasOnly(['status', 'name', 'size', 'type', 'duration', 'createdAt', 'source'])
        && d.status == 'inbox'
        && d.createdAt == request.time
        && (!('name' in d) || (d.name is string && d.name.size() <= 500))
        && (!('size' in d) || (d['size'] is number && d['size'] >= 0))
        && (!('type' in d) || (d['type'] is string && d['type'].size() <= 200))
        && (!('source' in d) || (d.source is string && d.source.size() <= 50))
        && (!('duration' in d) || (d.duration is number && d.duration > 0 && d.duration < 36000));
    }

    // Seuls status, song, voice et createdAt (heure du serveur) peuvent changer.
    // Classer : seulement depuis « À classer » (le premier qui classe gagne), et le morceau
    // (dans la même chorale) doit contenir ce fichier pour cette voix à la fin de la transaction.
    // c = '' : ancien emplacement (songs à la racine)
    function validFileChange(c, hash, d, before) {
      let changed = d.diff(before).affectedKeys();
      return changed.hasOnly(['status', 'song', 'voice', 'createdAt'])
        && (!('createdAt' in changed) || d.createdAt == request.time)
        && (!('song' in d) || d.song is string)
        && (!('voice' in d) || d.voice in ['S', 'A', 'H', 'T'])
        && (d.status == 'inbox'
          || (d.status == 'classified' && before.status == 'inbox'
            && songAfter(c, d.song).voices[d.voice].hash == hash));
    }
    function songAfter(c, songId) {
      return c == ''
        ? getAfter(/databases/$(database)/documents/songs/$(songId)).data
        : getAfter(/databases/$(database)/documents/choirs/$(c)/songs/$(songId)).data;
    }
  }
}
